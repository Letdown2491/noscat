+
+/// Other unixes (FreeBSD, OpenBSD, NetBSD, ...): no portable per-socket
+/// interface binding, so binding to a named interface is reported as
+/// unsupported instead of failing the build.
+#[cfg(all(
+    unix,
+    not(any(
+        target_os = "android",
+        target_os = "ios",
+        target_os = "linux",
+        target_os = "macos"
+    ))
+))]
+pub(crate) fn bind_socket_to_interface(
+    _socket: &Socket,
+    _bind_addr: SocketAddr,
+    interface: Option<&str>,
+) -> io::Result<()> {
+    match interface {
+        None => Ok(()),
+        Some(interface) => Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            format!("binding to interface {interface:?} is not supported on this platform"),
+        )),
+    }
+}
