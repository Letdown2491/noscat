# Maintainer: Letdown2491 <https://github.com/Letdown2491>
# AUR source package: builds noscat from the release tag with cargo.
# A template: the release workflow fills __VERSION__ and __B2SUM__ (of the
# tag's source tarball) and attaches the result, with .SRCINFO, to the
# release as noscat-aur-<tag>.tar.gz. Push those two files to
# ssh://aur@aur.archlinux.org/noscat.git. Bump pkgrel on PKGBUILD-only
# changes.
pkgname=noscat
pkgver=__VERSION__
pkgrel=1
pkgdesc="Like netcat, but over your own device mesh: npub-addressed, end-to-end encrypted, no root, no accounts"
arch=(x86_64 aarch64)
url="https://github.com/Letdown2491/noscat"
license=(MIT)
# The FIPS data plane links libdbus (its Bluetooth transport) on glibc and
# needs libclang at build time.
depends=(glibc dbus)
makedepends=(cargo clang)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
b2sums=('__B2SUM__')

build() {
    cd "$pkgname-$pkgver"
    export CARGO_TARGET_DIR=target
    cargo build --release --locked
    # Regenerate completions from the built binary (kept current with clap).
    ./target/release/noscat completions bash > noscat.bash
    ./target/release/noscat completions zsh  > _noscat
    ./target/release/noscat completions fish > noscat.fish
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/noscat -t "$pkgdir/usr/bin/"
    install -Dm644 packaging/noscat.1 "$pkgdir/usr/share/man/man1/noscat.1"
    install -Dm644 packaging/systemd/noscat.service "$pkgdir/usr/lib/systemd/user/noscat.service"
    install -Dm644 noscat.bash "$pkgdir/usr/share/bash-completion/completions/noscat"
    install -Dm644 _noscat "$pkgdir/usr/share/zsh/site-functions/_noscat"
    install -Dm644 noscat.fish "$pkgdir/usr/share/fish/vendor_completions.d/noscat.fish"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
